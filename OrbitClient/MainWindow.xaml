<Window x:Class="OrbitClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:OrbitClient.Scripts" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Orbit Client" Width="1220" Height="760" MinWidth="1000" MinHeight="650" WindowStyle="None" ResizeMode="CanResize" Background="#08060A" FontFamily="Segoe UI" FontSize="14" FontStyle="Normal" Typography.NumeralAlignment="Tabular" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PurpleTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DiscoverFilterCheckBox" TargetType="CheckBox">
                <Setter Property="MinHeight" Value="44" /><Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#211A29" BorderBrush="#695774" BorderThickness="1" CornerRadius="4">
                                    <TextBlock x:Name="Check" Text="✓" Foreground="White" FontSize="12" Visibility="Collapsed" HorizontalAlignment="Center"  TextWrapping="Wrap" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#DDB5F7" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NewsArticleButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Card" Background="#19131F" BorderBrush="#35283F" BorderThickness="1" CornerRadius="12" Padding="1">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#231A2C" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#9B73B5" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#DDB5F7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AnimatedCard" TargetType="Border" BasedOn="{StaticResource Card}" />
            <Style x:Key="AnimatedNav" TargetType="Button" BasedOn="{StaticResource Nav}" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="WindowRoot" Background="#08060A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="#0B080D" BorderBrush="#241A28" BorderThickness="0,0,1,0">
            <Grid Margin="15,8,15,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#17101D" BorderBrush="#3C214A" BorderThickness="1">
                        <Image Source="/OrbitClient;component/Assets/Orbit-removebg-preview.png" Width="30" Height="30" />
                    </Border>
                    <StackPanel x:Name="SidebarBrandText" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ORBIT" Foreground="#F7F3F9" FontSize="18" FontWeight="Bold"  TextWrapping="Wrap" />
                        
                    </StackPanel>
                </Grid>
                <Grid x:Name="SidebarNavigation" Grid.Row="1" ClipToBounds="False">
                    <StackPanel x:Name="NavPanel" Margin="0,6,0,0" VerticalAlignment="Top">
                        
                        <Button x:Name="HomeNav" Tag="Home" Click="Nav_Click" Style="{StaticResource AnimatedNav}" Background="{DynamicResource AccentSoft}" Foreground="#F8F2FC">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/OrbitClient;component/Assets/HomeIcon.png" Width="16" Height="16" />
                                <TextBlock Text="Home" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Steam accounts" Click="Nav_Click" Style="{StaticResource AnimatedNav}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/OrbitClient;component/Assets/PersonIcon.png" Width="16" Height="16" />
                                <TextBlock Text="Steam accounts" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Discover" Click="Nav_Click" Style="{StaticResource AnimatedNav}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/OrbitClient;component/Assets/assistant_navigation.png" Width="16" Height="16" />
                                <TextBlock Text="Discover" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Content="Installed mods" Tag="Mod Library" Click="Nav_Click" Style="{StaticResource AnimatedNav}" />
                        <Button Content="Capes" Tag="Capes" Click="Nav_Click" Style="{StaticResource AnimatedNav}" />
                        
                        <Button Margin="0,12,0,2" Tag="News" Click="Nav_Click" Style="{StaticResource AnimatedNav}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/OrbitClient;component/Assets/NewsIcon.png" Width="16" Height="16" />
                                <TextBlock Text="News" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        
                        <Button Margin="0,12,0,2" Content="Snapshots" Tag="Snapshots" Click="Nav_Click" Style="{StaticResource AnimatedNav}" />
                        <Button Content="BepInEx" Tag="BepInEx" Click="Nav_Click" Style="{StaticResource AnimatedNav}" />
                        <Button Content="Appearance" Tag="Appearance" Click="Nav_Click" Style="{StaticResource AnimatedNav}" />
                        <Button Tag="Settings" Click="Nav_Click" Style="{StaticResource AnimatedNav}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/OrbitClient;component/Assets/SettingsIcon.png" Width="16" Height="16" />
                                <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" BorderBrush="#241A28" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                    <Button x:Name="ProfileNav" Content="Profile" Tag="Accounts" Click="Nav_Click" Style="{StaticResource AnimatedNav}" ToolTip="Your Orbit profile" />
                </Border>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="#0E0A12" BorderBrush="#241B29" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="18,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Home" Foreground="#F6F1F8" FontSize="20" FontWeight="SemiBold"  TextWrapping="Wrap" />
                    <TextBlock x:Name="PageSubtitle" Text="" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"  TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="Transparent" Padding="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusCircle" Width="7" Height="7" Fill="#DC143C" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="1">
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="Services offline" Foreground="{DynamicResource Muted}" FontSize="12"  TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeWindowButton" Content="−" Click="Minimize_Click" Style="{StaticResource WindowBtn}" />
                    <Button x:Name="MaximizeWindowButton" Content="□" Click="Maximize_Click" Style="{StaticResource WindowBtn}" FontSize="12" />
                    <Button x:Name="CloseWindowButton" Content="×" Click="Close_Click" Style="{StaticResource WindowBtn}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Grid.Row="1">
            <Border x:Name="ContentBackground" IsHitTestVisible="False" />
            <Canvas x:Name="SharedNewsLayer" Panel.ZIndex="600" ClipToBounds="True" IsHitTestVisible="False" />
            <Canvas x:Name="StarField" Visibility="Collapsed" IsHitTestVisible="False" />
            <ScrollViewer x:Name="FeaturePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FeatureContent" Margin="18" />
            </ScrollViewer>
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border x:Name="HomeHero" Height="250" Margin="18,16,18,0" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Image Source="/OrbitClient;component/Assets/gorilla-forest.jpg" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="HeroImageScale" ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                            </Image>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F20C0910" Offset="0" />
                                        <GradientStop Color="#C7100C17" Offset=".48" />
                                        <GradientStop Color="#1009070B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel x:Name="HeroContent" Opacity="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20" MaxWidth="410">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="HeroTranslate" Y="20" />
                                </StackPanel.RenderTransform>
<TextBlock x:Name="GameHeading" Text="Gorilla Tag" Foreground="White" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="GameDescription" Text="Your game, mods, and next session in one place." Foreground="#E0D9E8" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,18" MaxWidth="340" HorizontalAlignment="Left" />
                                <Button x:Name="LaunchButton" Click="Launch_Click" Style="{StaticResource Primary}" Width="240" Height="48" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock x:Name="LaunchTitle" Text="Launch Gorilla Tag" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"  TextWrapping="Wrap" />
                                        <TextBlock x:Name="LaunchStatus" Text="" Visibility="Collapsed" Foreground="#F2E7F8" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"  TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                                <ProgressBar x:Name="LaunchProgress" Width="240" Height="4" HorizontalAlignment="Left" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Hidden" Foreground="#AF55F4" Background="#35203E" />
                            </StackPanel>

                        </Grid>
                    </Border>
                    <Grid Margin="18,16,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Tag="MotionCard" Style="{StaticResource AnimatedCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Steam account" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Bold"  TextWrapping="Wrap" />
                                <Grid MinHeight="32" Margin="0,6,0,0"><TextBlock x:Name="CurrentSteamAccount" MaxHeight="32" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="" Foreground="#F5F1F7" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"  TextWrapping="NoWrap" /><Border x:Name="CurrentSteamAccountSkeleton" Style="{StaticResource SkeletonBar}" Width="140" Height="26" /></Grid>
                                <TextBlock Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource AnimatedCard}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Game build" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Bold"  TextWrapping="Wrap" />
                                <Grid MinHeight="32" Margin="0,6,0,0"><TextBlock x:Name="GameVersionText" MaxHeight="32" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="" Foreground="#F5F1F7" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"  TextWrapping="NoWrap" /><Border x:Name="GameVersionTextSkeleton" Style="{StaticResource SkeletonBar}" Width="140" Height="26" /></Grid>
                                <TextBlock Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource AnimatedCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Playtime" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Bold"  TextWrapping="Wrap" />
                                <Grid MinHeight="32" Margin="0,6,0,0"><TextBlock x:Name="PlaytimeText" MaxHeight="32" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="" Foreground="#F5F1F7" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"  TextWrapping="NoWrap" /><Border x:Name="PlaytimeTextSkeleton" Style="{StaticResource SkeletonBar}" Width="140" Height="26" /></Grid>
                                <TextBlock Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"  TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Margin="18,18,18,18">
                        <TextBlock Text="Orbit release notes" Foreground="#F3EEF5" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"  TextWrapping="Wrap" />
                        <Grid>
                            
                            <Border Tag="MotionCard" Style="{StaticResource AnimatedCard}" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" Background="#21152A" BorderBrush="#432455" BorderThickness="1" CornerRadius="11">
                                        <Image x:Name="News1Logo" Source="/OrbitClient;component/Assets/Orbit-removebg-preview.png" Width="30" Height="30" />
                                    </Border>
                                    <StackPanel Grid.Column="1" MinHeight="60">
                                        <TextBlock x:Name="News1Title" Text="" Foreground="#EEE9F1" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="News1Desc" MaxHeight="34" TextTrimming="CharacterEllipsis" Text="" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <StackPanel x:Name="HomeNewsSkeleton" MinHeight="72"><Border Style="{StaticResource SkeletonBar}" Width="160" Height="16" Margin="0,0,0,6" /><Border Style="{StaticResource SkeletonBar}" Width="210" Height="12" /></StackPanel></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="Accounts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="OrbitAccountHost" Margin="18,18" MaxWidth="1000" HorizontalAlignment="Stretch" />
            </ScrollViewer>
            <ScrollViewer x:Name="SteamAccountsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,18" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Steam accounts" Foreground="#F4EFF7" FontSize="23" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            <TextBlock Text="Select which Steam account Orbit should use." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"  TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Click="RefreshAccounts_Click" Style="{StaticResource Primary}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="SteamAccountStatus" Foreground="#B3A6BD" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="Search accounts" Foreground="#B3A6BD" FontSize="12" Margin="0,0,0,6"  TextWrapping="Wrap" />
                    <TextBox x:Name="SteamAccountSearch" TextChanged="SteamAccountSearch_TextChanged" AutomationProperties.Name="Search Steam accounts" ToolTip="Search Steam accounts" Padding="8,6" Margin="0,0,0,10" Background="{DynamicResource ControlSurface}" Foreground="White" BorderBrush="#302737" />
                    <StackPanel x:Name="AccountList" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="Discover" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="16"><Border Style="{StaticResource Card}" Padding="32" MaxWidth="1250" VerticalAlignment="Top"><StackPanel><TextBlock Text="Discover" Foreground="#F4EFF7" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Coming soon" Foreground="#A99AB2" FontSize="18" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></Border><StackPanel x:Name="DiscoverContent" Margin="16" MaxWidth="1250" Visibility="Collapsed">
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="DiscoverHeading" Text="Find Gorilla Tag mods" Foreground="#F4EFF7" FontSize="24" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            <TextBlock x:Name="DiscoverDescription" Text="Find something new for your next session." Foreground="#A99AB2" FontSize="13" Margin="0,6,0,0"  TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="DiscoverSubmitButton" Grid.Column="1" Content="Submit a mod" Click="SubmitMod_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Ghost}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DiscoverSidebarColumn" Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border x:Name="DiscoverCategorySection" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="DiscoverCategoryHeading" Text="Category" Foreground="#F4EFF7" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"  TextWrapping="Wrap" />
                                    <StackPanel x:Name="DiscoverCategoryFilters" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DiscoverAuthorSection" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="DiscoverAuthorHeading" Text="Author" Foreground="#F4EFF7" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"  TextWrapping="Wrap" />
                                    <StackPanel x:Name="DiscoverAuthorFilters" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="DiscoverClearButton" Content="Clear filters" Click="ClearDiscoverFilters_Click" Style="{StaticResource Ghost}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Background="#241D2C" BorderBrush="#44354F" BorderThickness="1" CornerRadius="10" Padding="8,4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="DiscoverSearchIconHost" VerticalAlignment="Center" />
                                    <TextBox x:Name="DiscoverSearchBox" Grid.Column="1" Height="36" Background="Transparent" Foreground="#F4EFF7" BorderThickness="0" Padding="4,6" CaretBrush="White" AutomationProperties.Name="Search mods" TextChanged="DiscoverSearchBox_TextChanged" />
                                    <TextBlock x:Name="DiscoverPlaceholder" Grid.Column="1" Text="Search mods, descriptions, or authors…" Foreground="#A99AB2" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DiscoverSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <WrapPanel Margin="0,0,0,8">
                                <ComboBox x:Name="DiscoverSortBox" SelectionChanged="DiscoverSort_SelectionChanged" Style="{StaticResource OrbitComboBox}" MinWidth="156" Margin="0,0,6,6" AutomationProperties.Name="Sort mods" ToolTip="Choose the order of mod results" />
                                <ComboBox x:Name="DiscoverPageSizeBox" SelectionChanged="DiscoverPageSize_SelectionChanged" Style="{StaticResource OrbitComboBox}" MinWidth="132" Margin="0,0,6,6" AutomationProperties.Name="Results per page" ToolTip="Choose how many mods appear on each page" />
                                <Button x:Name="DiscoverRefreshButton" Content="Refresh ↻" Click="RefreshDiscover_Click" Style="{StaticResource Ghost}" Padding="8,6" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock x:Name="DiscoverStatusText" MinHeight="18" Text="" Foreground="#A99AB2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel x:Name="DiscoverModsPanel" />
                            <Border x:Name="DiscoverEmptyState" Visibility="Collapsed" Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="DiscoverEmptyHeading" Text="No matching mods" Foreground="#F4EFF7" FontSize="20" FontWeight="SemiBold"  TextWrapping="Wrap" />
                                    <TextBlock x:Name="DiscoverEmptyDescription" Text="Try another search or clear your filters." Foreground="#A99AB2" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button x:Name="DiscoverPreviousButton" Content="←" Click="DiscoverPrevious_Click" Style="{StaticResource Ghost}" AutomationProperties.Name="Previous page" />
                                <TextBlock x:Name="DiscoverPageText" Foreground="#CFC4D5" VerticalAlignment="Center" Margin="10,0"  TextWrapping="Wrap" />
                                <Button x:Name="DiscoverNextButton" Content="→" Click="DiscoverNext_Click" Style="{StaticResource Ghost}" AutomationProperties.Name="Next page" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid></ScrollViewer>
            <ScrollViewer x:Name="News" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18" MaxWidth="1050" HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Orbit news and release notes" Foreground="#F4EFF7" FontSize="24" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            <TextBlock Text="Read what changed and how to use it." Foreground="#B8ACBF" FontSize="13" Margin="0,6,10,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Click="RefreshNews_Click" Style="{StaticResource Ghost}" Height="36" MinWidth="96" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="NewsStatusText" MinHeight="18" Text="" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"  TextWrapping="Wrap" />
                    <StackPanel x:Name="FeaturedNewsPanel" />
                    <TextBlock x:Name="MoreNewsHeading" Visibility="Collapsed" Text="More articles" Foreground="#F4EFF7" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,12"  TextWrapping="Wrap" />
                    <WrapPanel x:Name="NewsListPanel" SizeChanged="NewsListPanel_SizeChanged" />
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="NewsDetailsOverlay" Visibility="Collapsed" Background="#100D14" Panel.ZIndex="500" KeyDown="NewsDetails_KeyDown" KeyboardNavigation.TabNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border BorderBrush="#302638" BorderThickness="0,0,0,1" Padding="18,10">
                    <Button x:Name="NewsBackButton" Content="←  All news" Click="CloseNewsDetails_Click" HorizontalAlignment="Left" Style="{StaticResource Primary}" Padding="10,6" />
                </Border>
                <ScrollViewer x:Name="NewsDetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,32" MaxWidth="760">
                        <TextBlock x:Name="NewsDetailsTitle" Foreground="#F4EFF7" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="NewsDetailsDescription" Foreground="#B8ACBF" FontSize="16" LineHeight="25" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock x:Name="NewsDetailsDate" Foreground="#C69CE4" FontSize="12" Margin="0,0,0,16"  TextWrapping="Wrap" />
                        <Border x:Name="NewsDetailsImageHost" Background="#21152A" Margin="0,0,0,18" ClipToBounds="True" />
                        <TextBlock x:Name="NewsDetailsContent" MaxWidth="600" HorizontalAlignment="Left" Foreground="#D5CDD9" FontSize="16" LineHeight="26" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsContent" Margin="18,18" MaxWidth="850" HorizontalAlignment="Left">
                    <Border Tag="MotionCard" Style="{StaticResource AnimatedCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="GENERAL" Foreground="#7D7184" FontSize="12" FontWeight="Bold" Margin="0,0,0,17"  TextWrapping="Wrap" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Close Orbit after launch" Foreground="#EEE9F1" FontSize="12" FontWeight="SemiBold"  TextWrapping="Wrap" />
                                    <TextBlock Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"  TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton x:Name="CloseAppAfterLaunchButton" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Automatically check for updates" Foreground="#EEE9F1" FontSize="12" FontWeight="SemiBold"  TextWrapping="Wrap" />
                                    <TextBlock Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"  TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Tag="MotionCard" Style="{StaticResource AnimatedCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="GAME INSTALLATION" Foreground="#7D7184" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"  TextWrapping="Wrap" />
                            <TextBlock Text="Gorilla Tag directory" Foreground="#EEE9F1" FontSize="12" FontWeight="SemiBold"  TextWrapping="Wrap" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPath" Text="C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag" Background="#0C0A0F" Foreground="#968A9D" BorderBrush="#302737" BorderThickness="1" Padding="11,6" />
                                <Button Grid.Column="1" Content="BROWSE" Click="Browse_Click" Style="{StaticResource Ghost}" Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Tag="MotionCard" Style="{StaticResource AnimatedCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Orbit Client" Foreground="#EEE9F1" FontSize="12" FontWeight="SemiBold"  TextWrapping="Wrap" />
                                <TextBlock x:Name="UpdateText" Text="You are on Version" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"  TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="CHECK FOR UPDATES" Click="Update_Click" Style="{StaticResource Ghost}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Expander Header="Steam options" Foreground="#EEE9F1" Margin="0,0,0,10">
                        <Border Tag="MotionCard" Style="{StaticResource AnimatedCard}">
                            <StackPanel>
                                <TextBlock Text="STEAM INFORMATION" Foreground="#7D7184" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"  TextWrapping="Wrap" />
                                <TextBlock Text="Steam API access" Foreground="#EEE9F1" FontSize="12" FontWeight="SemiBold"  TextWrapping="Wrap" />
                                <TextBlock Text="Optional Steam API information." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,10"  TextWrapping="Wrap" />
                                <TextBlock Text="Steam API Key" Foreground="#807585" FontSize="12" Margin="0,0,0,5"  TextWrapping="Wrap" />
                                <PasswordBox x:Name="SteamApiKeyBox" Height="36" Background="#0C0A0F" Foreground="#EEE9F1" BorderBrush="#302737" BorderThickness="1" Padding="6,6" Margin="0,0,0,8" />
                                <TextBlock Text="SteamID64" Foreground="#807585" FontSize="12" Margin="0,0,0,5"  TextWrapping="Wrap" />
                                <PasswordBox x:Name="SteamIdBox" Height="36" Background="#0C0A0F" Foreground="#EEE9F1" BorderBrush="#302737" BorderThickness="1" Padding="6,6" Margin="0,0,0,10" />
                                <Button Content="SAVE STEAM INFORMATION" Height="36" Click="Submit_Click" Style="{StaticResource Ghost}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
